/*
 * Scaleri theme
 *
 * A dark, blocky theme inspired by Minecraft's own interface: deepslate greys, square corners,
 * bevelled buttons and grass-green accents. Colours match ScaleriTheme::colorScheme().
 *
 *   #121213  outline          #1e1e1f  well / input        #262627  bar
 *   #313233  window           #48494a  button face         #5a5b5c  border
 *   #6d6e70  bevel highlight  #3c8527  accent              #6cc349  accent highlight
 *   #1d4d13  accent shade     #9be15d  accent text
 */

/* ---------- Tooltips: Minecraft item-tooltip style ---------- */

QToolTip {
    color: #ffffff;
    background-color: #100010;
    border: 2px solid #2d0a63;
    padding: 4px 6px;
}

/* ---------- Window chrome ---------- */

QMainWindow::separator {
    background-color: #121213;
    width: 2px;
    height: 2px;
}

QMenuBar {
    background-color: #262627;
    border-bottom: 2px solid #121213;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #3c8527;
}

QStatusBar {
    background-color: #262627;
    border-top: 2px solid #121213;
}

QSplitter::handle {
    background-color: #121213;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ---------- Toolbars ---------- */

QToolBar {
    background-color: #262627;
    border: none;
    spacing: 2px;
    padding: 3px;
}

QToolBar#mainToolBar {
    border-bottom: 2px solid #121213;
}

QToolBar#instanceToolBar {
    border-left: 2px solid #121213;
}

QToolBar#newsToolBar {
    border-top: 2px solid #121213;
}

QToolBar::separator {
    background-color: #3a3b3c;
    width: 2px;
    height: 2px;
    margin: 4px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: 2px solid transparent;
    padding: 4px 6px;
}

QToolBar QToolButton:hover {
    background-color: #48494a;
    border-color: #121213;
    border-top-color: #6d6e70;
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked,
QToolBar QToolButton:open {
    background-color: #3c8527;
    border-color: #121213;
    border-top-color: #6cc349;
}

QToolBar QToolButton:disabled {
    color: #6d6e70;
}

QToolButton::menu-indicator {
    image: url(:/scaleri/arrow-down.svg);
    width: 7px;
    height: 4px;
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
}

QToolButton[popupMode="1"] {
    padding-right: 16px;
}

QToolButton::menu-button {
    border: none;
    width: 14px;
}

QToolButton::menu-arrow {
    image: url(:/scaleri/arrow-down.svg);
    width: 7px;
    height: 4px;
}

/* ---------- Push buttons: bevelled blocks ---------- */

QPushButton {
    color: #ffffff;
    border: 2px solid #121213;
    padding: 5px 14px 7px 14px;
    min-height: 16px;
    min-width: 64px;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #6d6e70, stop: 0.1 #6d6e70,
        stop: 0.1001 #48494a, stop: 0.84 #48494a,
        stop: 0.8401 #313233, stop: 1 #313233);
}

QPushButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #838487, stop: 0.1 #838487,
        stop: 0.1001 #5a5b5c, stop: 0.84 #5a5b5c,
        stop: 0.8401 #3a3b3c, stop: 1 #3a3b3c);
}

QPushButton:pressed,
QPushButton:checked {
    padding: 7px 14px 5px 14px;
    background-color: #3a3b3c;
}

QPushButton:default {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #6cc349, stop: 0.1 #6cc349,
        stop: 0.1001 #3c8527, stop: 0.84 #3c8527,
        stop: 0.8401 #1d4d13, stop: 1 #1d4d13);
}

QPushButton:default:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #86d65f, stop: 0.1 #86d65f,
        stop: 0.1001 #4a9a32, stop: 0.84 #4a9a32,
        stop: 0.8401 #24601a, stop: 1 #24601a);
}

QPushButton:default:pressed {
    background-color: #2f6a1f;
}

QPushButton:disabled {
    color: #6d6e70;
    background-color: #2a2b2c;
    border-color: #1e1e1f;
}

QPushButton:focus {
    outline: none;
}

QPushButton::menu-indicator {
    image: url(:/scaleri/arrow-down.svg);
    width: 7px;
    height: 4px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
}

QPushButton[flat="true"] {
    background: transparent;
    border-color: transparent;
}

QPushButton[flat="true"]:hover {
    background-color: #48494a;
    border-color: #121213;
}

/* Small buttons that sit inside forms (e.g. "Browse", "...") */
QToolButton {
    background-color: #48494a;
    border: 2px solid #121213;
    border-top-color: #6d6e70;
    padding: 3px;
}

QToolButton:hover {
    background-color: #5a5b5c;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #3c8527;
    border-top-color: #6cc349;
}

QToolButton:disabled {
    color: #6d6e70;
    background-color: #2a2b2c;
    border-top-color: #121213;
}

QToolButton[autoRaise="true"] {
    background-color: transparent;
    border-color: transparent;
}

QToolButton[autoRaise="true"]:hover {
    background-color: #48494a;
    border-color: #121213;
}

/* ---------- Text inputs ---------- */

QLineEdit,
QPlainTextEdit,
QTextEdit,
QAbstractSpinBox,
QKeySequenceEdit {
    background-color: #1e1e1f;
    border: 2px solid #5a5b5c;
    padding: 3px 5px;
    selection-background-color: #3c8527;
    selection-color: #ffffff;
}

QTextBrowser {
    border: 2px solid #121213;
}

QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover,
QAbstractSpinBox:hover {
    border-color: #6d6e70;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QAbstractSpinBox:focus {
    border-color: #6cc349;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QAbstractSpinBox:disabled {
    color: #6d6e70;
    border-color: #3a3b3c;
}

QLineEdit[readOnly="true"] {
    background-color: #262627;
}

QAbstractSpinBox {
    padding-right: 20px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #48494a;
    border-left: 2px solid #5a5b5c;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 1px solid #5a5b5c;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: #5a5b5c;
}

QAbstractSpinBox::up-button:pressed,
QAbstractSpinBox::down-button:pressed {
    background-color: #3c8527;
}

QAbstractSpinBox::up-arrow {
    image: url(:/scaleri/arrow-up.svg);
    width: 7px;
    height: 4px;
}

QAbstractSpinBox::down-arrow {
    image: url(:/scaleri/arrow-down.svg);
    width: 7px;
    height: 4px;
}

QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off {
    image: url(:/scaleri/arrow-up-disabled.svg);
}

QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off {
    image: url(:/scaleri/arrow-down-disabled.svg);
}

/* ---------- Combo boxes ---------- */

QComboBox {
    background-color: #48494a;
    border: 2px solid #121213;
    border-top-color: #6d6e70;
    padding: 3px 26px 3px 6px;
    min-height: 18px;
    selection-background-color: #3c8527;
}

QComboBox:hover {
    background-color: #5a5b5c;
}

QComboBox:editable {
    background-color: #1e1e1f;
    border: 2px solid #5a5b5c;
}

QComboBox:editable:focus,
QComboBox:on {
    border-color: #6cc349;
}

QComboBox:disabled {
    color: #6d6e70;
    background-color: #2a2b2c;
    border-color: #1e1e1f;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border: none;
}

QComboBox::down-arrow {
    image: url(:/scaleri/arrow-down.svg);
    width: 7px;
    height: 4px;
}

QComboBox::down-arrow:disabled {
    image: url(:/scaleri/arrow-down-disabled.svg);
}

QComboBox QAbstractItemView {
    background-color: #262627;
    border: 2px solid #121213;
    selection-background-color: #3c8527;
    selection-color: #ffffff;
    outline: none;
}

/* ---------- Item views ---------- */

QAbstractItemView {
    background-color: #1e1e1f;
    alternate-background-color: #252526;
    border: 2px solid #121213;
    selection-background-color: #3c8527;
    selection-color: #ffffff;
    outline: none;
}

QAbstractItemView:disabled {
    color: #6d6e70;
}

QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #313233;
}

QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #3c8527;
    color: #ffffff;
}

QListView::item:selected:!active,
QTreeView::item:selected:!active,
QTableView::item:selected:!active {
    background-color: #2f5f22;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/scaleri/arrow-right.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/scaleri/arrow-down.svg);
}

QHeaderView {
    background-color: #262627;
    border: none;
}

QHeaderView::section {
    background-color: #262627;
    color: #d0d1d4;
    border: none;
    border-right: 2px solid #1e1e1f;
    border-bottom: 2px solid #121213;
    padding: 4px 8px;
}

QHeaderView::section:hover {
    background-color: #313233;
    color: #ffffff;
}

QHeaderView::down-arrow {
    image: url(:/scaleri/arrow-down.svg);
    width: 7px;
    height: 4px;
    padding-right: 4px;
}

QHeaderView::up-arrow {
    image: url(:/scaleri/arrow-up.svg);
    width: 7px;
    height: 4px;
    padding-right: 4px;
}

QTableCornerButton::section {
    background-color: #262627;
    border: none;
}

/* ---------- Check boxes and radio buttons ---------- */

QCheckBox,
QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator {
    width: 12px;
    height: 12px;
    background-color: #1e1e1f;
    border: 2px solid #5a5b5c;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover,
QGroupBox::indicator:hover,
QAbstractItemView::indicator:hover {
    border-color: #6cc349;
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked {
    background-color: #3c8527;
    border-color: #6cc349;
    image: url(:/scaleri/check.svg);
}

QCheckBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate {
    background-color: #3c8527;
    border-color: #6cc349;
    image: url(:/scaleri/dot.svg);
}

QRadioButton::indicator {
    border-radius: 8px;
}

QRadioButton::indicator:checked {
    background-color: #3c8527;
    border-color: #6cc349;
    image: url(:/scaleri/dot.svg);
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled,
QGroupBox::indicator:disabled,
QAbstractItemView::indicator:disabled {
    background-color: #262627;
    border-color: #3a3b3c;
}

/* ---------- Group boxes ---------- */

QGroupBox {
    border: 2px solid #1e1e1f;
    margin-top: 12px;
    padding: 10px 6px 6px 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #9be15d;
}

QGroupBox::title:disabled {
    color: #6d6e70;
}

/* ---------- Tabs ---------- */

QTabWidget::pane {
    border: 2px solid #121213;
    background-color: #313233;
    top: -2px;
}

QTabBar::tab {
    background-color: #262627;
    color: #a8a9ac;
    border: 2px solid #121213;
    padding: 5px 14px;
    margin-right: -2px;
}

QTabBar::tab:top {
    border-bottom: none;
    border-top: 3px solid #121213;
}

QTabBar::tab:selected {
    background-color: #313233;
    color: #ffffff;
}

QTabBar::tab:top:selected {
    border-top-color: #6cc349;
}

QTabBar::tab:hover:!selected {
    background-color: #3a3b3c;
    color: #ffffff;
}

QTabBar::tab:disabled {
    color: #5a5b5c;
}

QTabBar::scroller {
    width: 24px;
}

QTabBar QToolButton {
    background-color: #262627;
    border: 2px solid #121213;
}

QTabBar::left-arrow {
    image: url(:/scaleri/arrow-left.svg);
}

QTabBar::right-arrow {
    image: url(:/scaleri/arrow-right.svg);
}

/* ---------- Menus ---------- */

QMenu {
    background-color: #262627;
    border: 2px solid #121213;
    padding: 4px 0;
}

QMenu::item {
    padding: 5px 24px 5px 28px;
    background: transparent;
}

QMenu::item:selected {
    background-color: #3c8527;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #6d6e70;
}

QMenu::icon {
    padding-left: 6px;
}

QMenu::separator {
    height: 2px;
    background-color: #3a3b3c;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 10px;
    height: 10px;
    left: 8px;
    background-color: #1e1e1f;
    border: 2px solid #5a5b5c;
}

QMenu::indicator:checked {
    background-color: #3c8527;
    border-color: #6cc349;
    image: url(:/scaleri/check.svg);
}

QMenu::right-arrow {
    image: url(:/scaleri/arrow-right.svg);
    width: 4px;
    height: 7px;
    padding-right: 8px;
}

/* ---------- Scroll bars: chunky square thumbs ---------- */

QScrollBar:vertical {
    background-color: #1e1e1f;
    width: 14px;
    margin: 0;
    border: none;
}

QScrollBar:horizontal {
    background-color: #1e1e1f;
    height: 14px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #5a5b5c;
    border: 2px solid #1e1e1f;
    border-left-width: 3px;
    min-height: 28px;
}

QScrollBar::handle:horizontal {
    background-color: #5a5b5c;
    border: 2px solid #1e1e1f;
    border-top-width: 3px;
    min-width: 28px;
}

QScrollBar::handle:hover {
    background-color: #6d6e70;
}

QScrollBar::handle:pressed {
    background-color: #6cc349;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

/* ---------- Progress bars: an XP bar ---------- */

QProgressBar {
    background-color: #1e1e1f;
    border: 2px solid #121213;
    color: #ffffff;
    text-align: center;
    min-height: 14px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #9be15d, stop: 0.3 #9be15d,
        stop: 0.3001 #6cc349, stop: 0.75 #6cc349,
        stop: 0.7501 #3c8527, stop: 1 #3c8527);
}

/* ---------- Sliders ---------- */

QSlider::groove:horizontal {
    height: 6px;
    background-color: #1e1e1f;
    border: 2px solid #121213;
}

QSlider::sub-page:horizontal {
    background-color: #3c8527;
    border: 2px solid #121213;
}

QSlider::handle:horizontal {
    width: 10px;
    margin: -7px 0;
    background-color: #d0d1d4;
    border: 2px solid #121213;
    border-bottom-color: #121213;
}

QSlider::handle:horizontal:hover {
    background-color: #ffffff;
}

QSlider::groove:vertical {
    width: 6px;
    background-color: #1e1e1f;
    border: 2px solid #121213;
}

QSlider::add-page:vertical {
    background-color: #3c8527;
    border: 2px solid #121213;
}

QSlider::handle:vertical {
    height: 10px;
    margin: 0 -7px;
    background-color: #d0d1d4;
    border: 2px solid #121213;
}

/* ---------- Misc ---------- */

QLabel:disabled {
    color: #6d6e70;
}

QCommandLinkButton {
    border: 2px solid #121213;
    background-color: #48494a;
    padding: 6px;
}

QCommandLinkButton:hover {
    background-color: #5a5b5c;
}

/* ---------- The big green Play button ---------- */

QToolBar QToolButton[actionName="actionLaunchInstance"] {
    color: #ffffff;
    font-weight: bold;
    padding: 8px 6px;
    border: 2px solid #121213;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #6cc349, stop: 0.1 #6cc349,
        stop: 0.1001 #3c8527, stop: 0.84 #3c8527,
        stop: 0.8401 #1d4d13, stop: 1 #1d4d13);
}

QToolBar QToolButton[actionName="actionLaunchInstance"]:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #86d65f, stop: 0.1 #86d65f,
        stop: 0.1001 #4a9a32, stop: 0.84 #4a9a32,
        stop: 0.8401 #24601a, stop: 1 #24601a);
}

QToolBar QToolButton[actionName="actionLaunchInstance"]:pressed,
QToolBar QToolButton[actionName="actionLaunchInstance"]:open {
    background-color: #2f6a1f;
}

QToolBar QToolButton[actionName="actionLaunchInstance"]:disabled {
    color: #6d6e70;
    background-color: #2a2b2c;
    border-color: #1e1e1f;
}

QToolBar QToolButton[actionName="actionLaunchInstance"]::menu-button {
    border-left: 2px solid #1d4d13;
}

/* ======================================================================
 * Home screen (ui/scaleri/HomeWidget)
 * ====================================================================== */

#scaleriSidebar {
    background-color: #1a1a1b;
    border-right: 2px solid #121213;
}

#scaleriWordmark {
    color: #9be15d;
}

#scaleriSidebar QToolButton[sidebarButton="true"] {
    background-color: transparent;
    border: 2px solid transparent;
    color: #d0d1d4;
    padding: 6px 10px;
    text-align: left;
}

#scaleriSidebar QToolButton[sidebarButton="true"]:hover {
    background-color: #313233;
    border-color: #121213;
    border-left: 4px solid #6cc349;
    color: #ffffff;
}

#scaleriSidebar QToolButton[sidebarButton="true"]:pressed,
#scaleriSidebar QToolButton[sidebarButton="true"]:open {
    background-color: #3c8527;
    color: #ffffff;
}

#scaleriSidebar QToolButton[sidebarButton="true"]::menu-indicator {
    image: none;
    width: 0;
}

#scaleriSidebar QToolButton[sidebarFooter="true"] {
    background-color: #262627;
    border: 2px solid #121213;
    border-top-color: #3a3b3c;
}

#scaleriMain {
    background-color: #1e1e1f;
}

#heroEyebrow {
    color: #9be15d;
    font-weight: bold;
}

#heroTitle {
    color: #ffffff;
}

#heroDetails {
    color: #d0d1d4;
}

#heroPlaytime {
    color: #a8a9ac;
}

#heroInstanceIcon {
    background-color: rgba(18, 18, 19, 170);
    border: 2px solid #121213;
    border-top-color: #5a5b5c;
}

#heroInstanceIcon:hover {
    background-color: rgba(60, 133, 39, 170);
    border-top-color: #6cc349;
}

QToolButton#heroPlayButton {
    color: #ffffff;
    border: 2px solid #121213;
    padding: 8px 28px 10px 28px;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #6cc349, stop: 0.08 #6cc349,
        stop: 0.0801 #3c8527, stop: 0.86 #3c8527,
        stop: 0.8601 #1d4d13, stop: 1 #1d4d13);
}

QToolButton#heroPlayButton:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #86d65f, stop: 0.08 #86d65f,
        stop: 0.0801 #4a9a32, stop: 0.86 #4a9a32,
        stop: 0.8601 #24601a, stop: 1 #24601a);
}

QToolButton#heroPlayButton:pressed {
    background-color: #2f6a1f;
    padding: 10px 28px 8px 28px;
}

QToolButton#heroPlayButton:disabled {
    color: #6d6e70;
    background-color: #2a2b2c;
    border-color: #1e1e1f;
}

QToolButton#heroPlayButton[popupMode="1"] {
    padding-right: 40px;
}

QToolButton#heroPlayButton::menu-button {
    width: 26px;
    border: none;
    border-left: 2px solid #1d4d13;
}

QToolButton#heroPlayButton::menu-arrow {
    image: url(:/scaleri/arrow-down.svg);
    width: 9px;
    height: 5px;
}

QToolButton[heroSecondary="true"] {
    color: #ffffff;
    border: 2px solid #121213;
    padding: 6px 14px 8px 14px;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #6d6e70, stop: 0.08 #6d6e70,
        stop: 0.0801 #48494a, stop: 0.86 #48494a,
        stop: 0.8601 #313233, stop: 1 #313233);
}

QToolButton[heroSecondary="true"]:hover {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #838487, stop: 0.08 #838487,
        stop: 0.0801 #5a5b5c, stop: 0.86 #5a5b5c,
        stop: 0.8601 #3a3b3c, stop: 1 #3a3b3c);
}

QToolButton[heroSecondary="true"]:pressed,
QToolButton[heroSecondary="true"]:open {
    background-color: #3a3b3c;
}

QToolButton[heroSecondary="true"]:disabled {
    color: #6d6e70;
    background-color: #2a2b2c;
    border-color: #1e1e1f;
}

QToolButton#heroMoreButton::menu-indicator {
    image: url(:/scaleri/arrow-down.svg);
    subcontrol-position: center right;
    right: 8px;
}

QToolButton#heroMoreButton {
    padding-right: 26px;
}

#scaleriLibrary {
    background-color: #1e1e1f;
}

#libraryTitle {
    color: #ffffff;
}

#scaleriLibrary QAbstractItemView {
    border: none;
    background-color: #1e1e1f;
}

/* ---- Settings, Edit Instance, New Instance and mod browser pages ---- */

QListView#pageList {
    background-color: #1a1a1b;
    border: none;
    border-right: 2px solid #121213;
    padding: 8px 6px;
    font-weight: bold;
}

QListView#pageList::item {
    padding: 4px 8px;
    margin: 1px 0;
    border-left: 3px solid transparent;
}

QListView#pageList::item:hover {
    background-color: #2a2a2b;
}

QListView#pageList::item:selected {
    background-color: #2b3d23;
    border-left: 3px solid #6cc349;
    color: #ffffff;
}

QListView#pageList::item:selected:!active {
    background-color: #263320;
    border-left: 3px solid #4f9a35;
}

#pageHeader {
    background-color: #262627;
    border-bottom: 2px solid #121213;
}

QLabel#pageHeaderTitle {
    color: #ffffff;
}
